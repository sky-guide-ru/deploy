# Настройки Sky Guide на сервере. Скопируй в .env рядом с docker-compose.yml и впиши свои значения.
# .env никогда не коммить: в нём ключи и пароли. Здесь все значения пустые.
# Строки с решёткой — необязательные, справа стоит значение по умолчанию.
# Пароль или ключ с символом $ пиши как $$ (Docker Compose понимает $ как подстановку).

# ===== Сервер и Docker (DOCKER.md) =====
# Папка с этим репо на сервере. setup-vps.sh впишет её сам
APP_DIR=
# Домены через запятую: Caddy сам получит HTTPS-сертификат. Пусто — сайт по http://IP. Меняется командой set-domain.sh
SITE_DOMAIN=
# Адрес сайта (canonical, sitemap.xml, ссылки в письмах). set-domain.sh впишет его сам
SITE_URL=
# vps — включить автообновление из main (контейнер updater). Пусто — без него (на ПК и в тестовом запуске)
COMPOSE_PROFILES=
# Порты Caddy на сервере: другие нужны только для тестового запуска рядом с живым сайтом
# HTTP_PORT=80
# HTTPS_PORT=443

# ===== Автообновление =====
# Ставить только то, что слили в main эти логины GitHub (через запятую). Пусто — ставить всё, что попало в main
DEPLOY_MERGERS=
# Токен GitHub только для чтения: без него проверка «кто слил» ограничена 60 запросами в час (обычно хватает)
GITHUB_TOKEN=
# AUTO_UPDATE=1            0 — выключить автообновление
# AUTO_UPDATE_SEC=60       как часто проверять main, секунд (не меньше 20)

# ===== Hypixel и профиль владельца =====
# Ключ Hypixel API с https://developer.hypixel.net
HYPIXEL_API_KEY=
# Ник владельца в Minecraft и имя профиля (пусто — выбранный в игре)
PLAYER=
PROFILE=
# Первый пароль владельца для входа (ник + пароль). Дальше пароли живут в data/users.json и меняются на /account
SITE_PASSWORD=
# Аккаунты без пароля при первом запуске, формат «Ник:Профиль,Ник2:Профиль»
SEED_FRIENDS=
# Ники игроков, попросивших не показывать их профиль посторонним (через запятую)
HIDDEN_PLAYERS=
# PROFILE_REFRESH=60       как часто обновлять профиль, секунд (не меньше 30)
# SESSION_SECRET=          свой секрет для cookie входа. Без него берётся data/session-secret.
#                          Не вписывай на работающем сайте: все входы на всех устройствах сбросятся

# ===== Открытый сайт и лимиты =====
# PUBLIC_VIEW=1            гость без входа открывает любой профиль по нику. 0 — только после входа
# GUEST_PLAYERS_PER_10MIN=30   сколько разных ников гость откроет с одного адреса за 10 минут
# API_PER_MIN=600          запросов к /api в минуту с одного адреса (владельца не касается)
# IMG_PER_MIN=3000         картинок в минуту с одного адреса
# HEADS_PER_MIN=240        аватарок в минуту с одного адреса
# STREAMS_PER_IP=8         открытых вкладок с живыми обновлениями с одного адреса
# V1_PER_MIN=120          запросов к открытому API /v1 в минуту с одного адреса или ключа
# TRUST_PROXY=             0 — не верить заголовку адреса посетителя ни от кого (по умолчанию верим своему Caddy)

# ===== Живой советчик (ИИ) =====
# Ключ из Claude Console (https://console.anthropic.com). Пусто — советы без ИИ (только движок правил)
ANTHROPIC_API_KEY=
# LIVE_DAILY_USD=0.20      лимит трат в день, $
# LIVE_MODEL=claude-haiku-5-5
# LIVE_TZ=Europe/Moscow    часовой пояс для дат в советах и границы суток бюджета
# LIVE_FRIEND_DAILY_QUESTIONS=20
# LIVE_OWNER_DAILY_QUESTIONS=100

# ===== Поисковики, счётчики, реклама, донаты (пусто — выключено) =====
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Свой ключ IndexNow (32 символа): поисковики узнают о новых страницах сразу
INDEXNOW_KEY=
YANDEX_METRIKA_ID=
# Блоки РСЯ вида R-A-1234567-1: внизу страниц и на стартовой
YANDEX_RTB_BOTTOM=
YANDEX_RTB_LANDING=
# Кнопка «Поддержать сайт»: ссылка на Boosty / DonationAlerts / ЮMoney (только https)
DONATE_URL=

# ===== Почта владельцу: отзывы, тревоги, сводка (пусто — отзывы только на сайте, раздел «Отзывы») =====
# Куда слать
MAIL_TO=
# Resend (resend.com → API Keys): письма по HTTPS, если хостинг закрыл почтовые порты
RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# SMTP (например, Gmail с паролем приложения https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Прямая отправка со своего сервера (порт 25, подпись DKIM). Нужны DNS-записи и PTR у хостера — docs/mail.md
MAIL_DOMAIN=
# MAIL_FROM=noreply@домен  MAIL_HELO=mail.домен  DKIM_SELECTOR=sky  MAIL_IP=
# MAIL_TRANSPORT=          resend или smtp — слать только так (например, пока у хостера нет PTR)

# ===== Правовое (страницы /privacy, /consent, /terms, /legal) =====
# Оператор персональных данных и почта для обращений. Без них на правовых страницах видно предупреждение
OPERATOR_NAME=
CONTACT_EMAIL=
OPERATOR_INN=
# BEHIND_CLOUDFLARE=0      1 — сайт за Cloudflare (упоминается в политике)

# ===== Текстуры и иконки =====
# Кому показывать текстуры ресурс-паков: пусто — авто (всем, пока нет РСЯ), all, none или части имён паков через запятую
PACKS_PUBLIC=
# RENDERS_PUBLIC=0         1 — готовые рендеры Coflnet для всех (только после разрешения Coflnet)

# ===== Фоновые задачи =====
# WIKI_WATCH=1             0 — не обновлять мэров и выборы с вики
# PRICE_BACKFILL=1         0 — не догружать историю цен
# BAZAAR_TICK=20           как часто обновлять Bazaar, секунд
# GEO_OFF=0                1 — не скачивать базу стран для статистики посещений
# GEO_DB_URL=              свой адрес базы стран (.mmdb)

# ===== Discord =====
# Webhook канала новостей (Канал → Настройки → Интеграции → Вебхуки → Копировать URL). Новости сайта и патчноуты
# SkyBlock уходят туда сами; что отправлено — data/discord-news.json. Пусто — ничего не отправляется
DISCORD_NEWS_WEBHOOK=
# Бот Sky Guide (/profile, /price, /next) — приложение в https://discord.com/developers/applications.
# В портале: General Information → Interactions Endpoint URL = https://ДОМЕН/discord/interactions.
# Бот живёт внутри api (своего контейнера нет) и берёт данные из кэша сайта. Пусто — бот выключен
# Application ID и Public Key — General Information. Токен — Bot → Reset Token (нужен, чтобы записать команды в Discord)
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Webhook канала событий SkyBlock: Jacob (с культурами), Dark Auction, мэр и выборы, Fire Sales, большие ивенты.
# Что отправлено — data/discord-events.json. Пусто — ничего не отправляется
DISCORD_EVENTS_WEBHOOK=
# Роли-подписки, которые пингуются (id роли: Настройки сервера → Роли → … → Копировать ID). Роли без id — без пинга
# DISCORD_EVENTS_ROLES=jacob=123,darkauction=456,mayor=789,firesale=111,events=222
