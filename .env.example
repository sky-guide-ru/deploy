# Ключ Hypixel API с https://developer.hypixel.net (никогда не коммить .env!)
HYPIXEL_API_KEY=
# Ник в Minecraft
PLAYER=Steve
# Друзья владельца: аккаунты без пароля при первом запуске. Формат «Ник:Профиль,Ник2:Профиль»
SEED_FRIENDS=
# Имя профиля (пусто = выбранный в игре)
PROFILE=
# Порт сайта
PORT=3000
# Как часто обновлять профиль, секунд (Hypixel кэширует данные ~1-3 минуты)
PROFILE_REFRESH=60
# Первый пароль владельца для входа из интернета (ник + пароль). Дальше пароли живут в data/users.json, меняются на /account.
# Пусто и нет аккаунтов с паролем = сайт открыт только на этом ПК
SITE_PASSWORD=
# С самого ПК (localhost) пускать без пароля: 1 = да, 0 = всегда спрашивать
AUTH_LOCAL=1
# Живой советчик: ключ API из Claude Console (https://console.anthropic.com). Пусто = советы без ИИ (только движок правил)
ANTHROPIC_API_KEY=
# Лимит трат на ИИ в день, $ (автосоветы останавливаются на 80%, остаток — для вопросов в чате)
LIVE_DAILY_USD=0.20
# Модель по умолчанию (самая дешёвая). Для кнопки «Подробнее» используется claude-sonnet-5-5
LIVE_MODEL=claude-haiku-5-5
# Часовой пояс: для дат в советах и границы суток бюджета
LIVE_TZ=Europe/Moscow
# Сколько вопросов в день можно задать советчику: друзьям (каждому) и владельцу
LIVE_FRIEND_DAILY_QUESTIONS=20
LIVE_OWNER_DAILY_QUESTIONS=100

# Автообновление в npm run share / npm run serve: раз в минуту git pull + build + перезапуск сервера (0 — выключить)
AUTO_UPDATE=1
# AUTO_UPDATE_SEC=60

# --- Открытый сайт, реклама и донаты (всё необязательно; пусто — выключено) ---
# Гость без входа вводит ник и смотрит любой профиль. Советчик и /account — только после входа. 0 — выключить
PUBLIC_VIEW=1
# Сколько разных ников гость может открыть с одного IP за 10 минут
GUEST_PLAYERS_PER_10MIN=30
# Адрес сайта на своём домене (canonical, sitemap.xml)
SITE_URL=
# Код из Яндекс Вебмастера (мета-тег yandex-verification, только сам код)
YANDEX_VERIFICATION=
# Подтверждение прав в Google Search Console и Bing Webmaster (код из мета-тега). Можно вписать и в server/public.js → VERIFY
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Номер счётчика Яндекс Метрики
YANDEX_METRIKA_ID=
# Блоки Рекламной сети Яндекса, вида R-A-1234567-1: внизу страниц и на стартовой (если пусто — как внизу)
YANDEX_RTB_BOTTOM=
YANDEX_RTB_LANDING=
# Кнопка «Поддержать сайт»: ссылка на Boosty / DonationAlerts / ЮMoney (только https)
DONATE_URL=

# --- Почта владельцу: отзывы «Сообщить об ошибке» (пусто — отзывы только сохраняются на сайте, раздел «Отзывы») ---
# Gmail: включи двухэтапную проверку, создай пароль приложения на https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
# Куда слать (пусто = SMTP_USER). Не Gmail — укажи свой сервер, порт 465 (TLS) или 587 (STARTTLS)
MAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Если хостинг закрыл серверу почтовые порты (465/587): отправка через Resend по HTTPS.
# Ключ: resend.com → API Keys. Без своего домена письма уходят только на почту, с которой
# зарегистрирован Resend, — её же укажи в MAIL_TO. Если задан и SMTP, он станет запасным.
RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# MAIL_TRANSPORT=smtp   — снова только SMTP (когда порты откроют)
# Прямая отправка со своего сервера (порт 25) с адреса noreply@домен, с подписью DKIM. Нужны DNS-записи и PTR
# у хостера — пошагово в docs/mail.md, проверка — «Сервер» → «Почта». Resend и SMTP выше остаются запасными.
# MAIL_DOMAIN=sky-guide.ru
# MAIL_FROM=noreply@sky-guide.ru      MAIL_HELO=mail.sky-guide.ru      DKIM_SELECTOR=sky
# MAIL_TRANSPORT=resend — временно выключить прямую отправку

# --- Правовое (страницы /privacy, /consent, /terms, /legal) ---
# ФИО владельца сайта (оператор персональных данных) и почта для обращений. Без них на правовых страницах видно предупреждение
OPERATOR_NAME=
CONTACT_EMAIL=
# ИНН (необязательно)
OPERATOR_INN=
# Ники игроков, попросивших не показывать их профиль посторонним (через запятую)
HIDDEN_PLAYERS=
# Сайт работает за Cloudflare (свой домен через Cloudflare) — упомянуть это в политике. Для trycloudflare определяется само
BEHIND_CLOUDFLARE=0
# Кому показывать текстуры ресурс-паков (Hypixel Plus — CC BY-NC-ND 4.0, некоммерческое; FurfSky Reborn — все права защищены).
# Пусто = авто: пока нет рекламы РСЯ — всем; как только задан YANDEX_RTB_* — только владельцу.
# all — всем всегда; none — только владельцу; или части имён файлов через запятую (паки с письменным разрешением автора)
PACKS_PUBLIC=
# Готовые рендеры иконок Coflnet (и папка db/icons) для всех посетителей: 1 — только после разрешения Coflnet
RENDERS_PUBLIC=0

# --- Docker на сервере (DOCKER.md) ---
# Домен сайта: Caddy сам получит SSL. Пусто — сайт по http://IP-сервера. Проще менять командой deploy/set-domain.sh
SITE_DOMAIN=
# vps — включить контейнер автообновления из main (ставит deploy/setup-vps.sh). На ПК не нужно
COMPOSE_PROFILES=
