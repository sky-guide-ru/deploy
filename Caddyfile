# SITE_DOMAIN: ":80" — без домена (http), "sb.example.ru" — домен с автоматическим SSL

# Журнал Caddy (docker compose logs caddy) — без данных посетителей. Журнал запросов не включён вовсе, а в записях
# об ошибках (например, «сайт не ответил») Caddy приписывает к ним IP, браузер и cookie посетителя — эти поля вырезаем
{
	log default {
		format filter {
			wrap json
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>tls delete
			remote_ip delete
			remote_port delete
			client_ip delete
		}
	}
}
{$SITE_DOMAIN} {
	encode zstd gzip
	# Браузер дальше ходит только по https (по http без домена заголовок браузеры просто не учитывают)
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000 {
		# Адрес посетителя Caddy передаёт сам (X-Forwarded-For). Подделанные клиентом заголовки убираем,
		# иначе лимит «ников с одного IP» обходился бы одной строчкой в запросе
		header_up -CF-Connecting-IP
		header_up -X-Real-IP
		# Живые обновления (SSE) — без буфера
		flush_interval -1
	}
	# Сайт не ответил (перезапуск после выкладки, сбой): вместо пустой белой страницы с ошибкой 502 — короткое
	# сообщение, и страница сама обновляется через 5 с. Только для открытия страниц: запросы /api и файлы получают ошибку как есть
	handle_errors 502 503 504 {
		@page header Accept *text/html*
		handle @page {
			header -Server
			header Cache-Control no-store
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
				<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
				<meta http-equiv="refresh" content="5"><title>SkyBlock</title></head>
				<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#14141c;color:#e8e8f0;font:16px/1.5 system-ui,sans-serif;text-align:center">
				<div style="padding:24px;max-width:520px"><p>Сайт обновляется или перезапускается. Страница откроется сама через несколько секунд.</p>
				<p style="opacity:.7">The site is updating or restarting. This page will reload by itself in a few seconds.</p></div></body></html>
				HTML 503
		}
	}
}
